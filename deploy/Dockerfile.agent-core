FROM python:3.12-slim

WORKDIR /app

COPY agent-core/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt -i https://pypi.tuna.tsinghua.edu.cn/simple --trusted-host pypi.tuna.tsinghua.edu.cn

COPY agent-core/app /app/app

ENV MOCK_MODE=1 \
    DETECTOR_BASE_URL=http://detectors:8001 \
    DATA_BASE_URL=http://sensitive-report:8002

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
