# 复制为 .env 后按需修改（docker compose 自动读取）
# 检测模式：1=使用内置 mock 检测器（B/C 未完成时可演示）；0=调用真实检测器
MOCK_MODE=1

# LLM 规划与研判（可选：不配置则自动使用规则版）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 数据库（与 docker-compose.yml 中 postgres 服务保持一致）
POSTGRES_USER=inspection
POSTGRES_PASSWORD=inspection_dev
POSTGRES_DB=inspection
